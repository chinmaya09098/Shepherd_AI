{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      }
    },
    "logLevel": {
      "default": "Information",
      "shepherd_ai": "Debug"
    }
  },
  "extensions": {
    "queues": {
      "batchSize": 1,
      "maxDequeueCount": 3,
      "newBatchThreshold": 0,
      "visibilityTimeout": "00:05:00",
      "maxPollingInterval": "00:02:00"
    },
    "http": {
      "routePrefix": "api",
      "maxOutstandingRequests": 200,
      "maxConcurrentRequests": 100,
      "dynamicThrottlesEnabled": true
    }
  },
  "functionTimeout": "00:10:00"
}
